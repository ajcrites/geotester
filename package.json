{
  "name": "geotester",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,html}\" \"!package-lock.json\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,html}\" \"!package-lock.json\" --ignore-path .gitignore",
    "data:fixture": "tsx scripts/install-fixture.ts",
    "data:collect": "tsx scripts/collect-data.ts",
    "data:gallery": "tsx scripts/data-gallery.ts",
    "test:data": "tsx --test scripts/data.test.ts",
    "data:validate": "tsx scripts/validate-data.ts --complete",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "test:domain": "tsx --test scripts/configuration.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "8.20.0",
    "d3-geo": "3.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "globals": "^16.5.0",
    "jiti": "^2.6.0",
    "lefthook": "2.2.2",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0"
  }
}
