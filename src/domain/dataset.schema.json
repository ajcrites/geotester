{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotester.local/schemas/dataset.schema.json",
  "title": "Complete Geotester US state dataset (fictional fixture excluded)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sample", "properties", "states"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sample": { "const": false },
    "properties": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "property.schema.json" }
    },
    "states": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "abbreviation",
        "fips",
        "capital",
        "shape",
        "flag"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^us-[a-z]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "abbreviation": {
          "enum": [
            "AL",
            "AK",
            "AZ",
            "AR",
            "CA",
            "CO",
            "CT",
            "DE",
            "FL",
            "GA",
            "HI",
            "ID",
            "IL",
            "IN",
            "IA",
            "KS",
            "KY",
            "LA",
            "ME",
            "MD",
            "MA",
            "MI",
            "MN",
            "MS",
            "MO",
            "MT",
            "NE",
            "NV",
            "NH",
            "NJ",
            "NM",
            "NY",
            "NC",
            "ND",
            "OH",
            "OK",
            "OR",
            "PA",
            "RI",
            "SC",
            "SD",
            "TN",
            "TX",
            "UT",
            "VT",
            "VA",
            "WA",
            "WV",
            "WI",
            "WY"
          ]
        },
        "fips": { "type": "string", "pattern": "^[0-9]{2}$" },
        "capital": { "type": "string", "minLength": 1 },
        "shape": {
          "type": "string",
          "pattern": "^assets/shapes/[a-z]+(?:-[a-z]+)*-shape\\.svg$"
        },
        "flag": {
          "type": "string",
          "pattern": "^assets/flags/[a-z]+(?:-[a-z]+)*-flag\\.svg$"
        }
      }
    }
  }
}
